      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:40px;padding:10px 15px;border:1px solid var(--lw-rule,#dce5df);border-radius:4px;background:var(--lw-paper,#fff);color:var(--lw-ink,#182e28);font:500 12px/1.5 Switzer,Arial,sans-serif;cursor:pointer;transition:background 150ms ease-out,border-color 150ms ease-out}.ds-button:hover{background:var(--lw-tint,#edf3ef);border-color:var(--lw-accent,#1c684e)}.ds-button:focus-visible{outline:2px solid var(--lw-accent,#1c684e);outline-offset:4px}.ds-button:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-primary{background:var(--lw-accent,#1c684e);border-color:var(--lw-accent,#1c684e);color:var(--lw-paper,#fff)}.ds-primary:hover{background:color-mix(in srgb,var(--lw-accent,#1c684e) 88%,var(--lw-ink,#182e28))}.ds-primary:active{background:color-mix(in srgb,var(--lw-accent,#1c684e) 88%,var(--lw-ink,#182e28))}:host-context(.dark) .ds-primary{color:#163025}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A bordered supporting action.",
      "html": "<button class=\"ds-button\">Season archive<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:40px;padding:10px 15px;border:1px solid var(--lw-rule,#dce5df);border-radius:4px;background:var(--lw-paper,#fff);color:var(--lw-ink,#182e28);font:500 12px/1.5 Switzer,Arial,sans-serif;cursor:pointer;transition:background 150ms ease-out,border-color 150ms ease-out}.ds-button:hover{background:var(--lw-tint,#edf3ef);border-color:var(--lw-accent,#1c684e)}.ds-button:focus-visible{outline:2px solid var(--lw-accent,#1c684e);outline-offset:4px}.ds-button:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}"
    },
    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "input-search",
      "description": "One bordered search group with a single focus treatment.",
      "html": "<label class=\"ds-search\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input aria-label=\"Find a player\" placeholder=\"Find a player…\"><span>72 players</span></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:9px;padding:10px 12px;background:var(--lw-bg,#f6f8f7);border:1px solid var(--lw-rule,#dce5df);border-radius:4px;color:var(--lw-muted,#596b64);font-family:Switzer,Arial,sans-serif;font-variant-numeric:tabular-nums;}.ds-search input{width:100%;min-width:0;border:0;outline:none;background:transparent;color:var(--lw-ink,#182e28);font:400 12px/1.5 Switzer,Arial,sans-serif}.ds-search input::placeholder{color:var(--lw-muted,#596b64)}.ds-search span{font-size:10px;white-space:nowrap}.ds-search:focus-within{outline:2px solid var(--lw-accent,#1c684e);outline-offset:2px}"
    },
    {
      "name": "Native select",
      "kind": "input",
      "refersTo": "input-select",
      "description": "Native model or market selection.",
      "html": "<select class=\"ds-select\" aria-label=\"Model\"><option>Original model</option><option>Research challenger</option></select>",
      "css": ".ds-select{font:400 12px/1.5 Switzer,Arial,sans-serif;background:var(--lw-paper,#fff);border:1px solid var(--lw-rule,#dce5df);color:var(--lw-ink,#182e28);border-radius:4px;padding:8px 28px 8px 10px;min-height:36px;max-width:100%}.ds-select:focus-visible{outline:2px solid var(--lw-accent,#1c684e);outline-offset:4px}"
    },
    {
      "name": "Primary navigation",
      "kind": "nav",
      "refersTo": "nav-selected",
      "description": "Pine navigation with a pale labeled selection.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><a href=\"#rankings\" aria-current=\"page\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M4 6h1M4 12h1M4 18h1M10 6h10M10 12h10M10 18h10\"/></svg>Rankings<svg class=\"ds-nav-arrow\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m9 6 6 6-6 6\"/></svg></a><a href=\"#markets\">Markets</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:6px;padding:18px;background:var(--lw-rail,#163d32);font-family:Switzer,Arial,sans-serif;font-variant-numeric:tabular-nums;}.ds-nav a{display:flex;align-items:center;gap:12px;padding:12px 15px;min-height:44px;border-radius:5px;font-size:13px;color:var(--lw-rail-text,#c0d1c6);text-decoration:none;transition:background 160ms ease-out,color 160ms ease-out}.ds-nav a:hover{background:#254d3e;color:#fff}.ds-nav a[aria-current=page]{background:#e2eddf;color:#234836;font-weight:500}.ds-nav-arrow{margin-left:auto}.ds-nav a:focus-visible{outline:2px solid var(--lw-accent,#1c684e);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-nav a{transition:none}}"
    },
    {
      "name": "Segmented control",
      "kind": "button",
      "refersTo": "segmented-selected",
      "description": "Context selection with a small pressed-state shadow.",
      "html": "<div class=\"ds-segmented\" role=\"group\" aria-label=\"Event view\"><button aria-pressed=\"true\">Upcoming</button><button aria-pressed=\"false\">In play</button></div>",
      "css": ".ds-segmented{display:inline-flex;background:var(--lw-tint,#edf3ef);border:1px solid var(--lw-rule,#dce5df);border-radius:5px;padding:3px;gap:3px}.ds-segmented button{border:0;background:transparent;color:var(--lw-muted,#596b64);padding:6px 12px;border-radius:3px;font:400 11px/1.5 Switzer,Arial,sans-serif;min-height:30px;cursor:pointer}.ds-segmented button[aria-pressed=true]{background:var(--lw-paper,#fff);color:var(--lw-ink,#182e28);box-shadow:0 1px 3px #142d2410}.ds-segmented button:hover{color:var(--lw-accent,#1c684e)}.ds-segmented button:focus-visible{outline:2px solid var(--lw-accent,#1c684e);outline-offset:4px}"
    },
    {
      "name": "Research status",
      "kind": "chip",
      "refersTo": "chip-research",
      "description": "Visible research status paired with text and SVG.",
      "html": "<span class=\"ds-research\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M9 3h6M10 3v7l-6 10h16l-6-10V3M8 16h8\"/></svg>Research challenger</span>",
      "css": ".ds-research{display:inline-flex;align-items:center;gap:6px;font:400 10px/1.5 Switzer,Arial,sans-serif;background:var(--lw-warning-bg,#f7f0e3);color:var(--lw-warning,#78541d);padding:5px 8px;border-radius:3px}"
    },
    {
      "name": "Evidence panel",
      "kind": "card",
      "refersTo": "panel-analysis",
      "description": "Flat paper panel with a rule and compact explanatory text.",
      "html": "<section class=\"ds-panel\"><h2>Probability calibration</h2><p>Does a 60% forecast win about 60% of the time?</p></section>",
      "css": ".ds-panel{background:var(--lw-paper,#fff);border:1px solid var(--lw-rule,#dce5df);border-radius:5px;padding:23px;color:var(--lw-ink,#182e28);font-family:Switzer,Arial,sans-serif;font-variant-numeric:tabular-nums;}.ds-panel h2{margin:0;font-size:18px;font-weight:500;line-height:1.35;letter-spacing:-.015em}.ds-panel p{font-size:12px;color:var(--lw-muted,#596b64);line-height:1.5;margin:5px 0 0;max-width:70ch}"
    },
    {
      "name": "Selected field record",
      "kind": "custom",
      "refersTo": "ranking-selected",
      "description": "Stable player identity and an aligned highlighted score.",
      "html": "<table class=\"ds-rank-table\"><thead><tr><th>Rank</th><th>Player</th><th>Score</th></tr></thead><tbody><tr class=\"ds-selected\"><td>1</td><th><button>Doug Ghim<svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m9 6 6 6-6 6\"/></svg></button></th><td class=\"ds-score\">72.1</td></tr><tr><td>2</td><th><button>Jacob Bridgeman</button></th><td class=\"ds-score\">71.9</td></tr></tbody></table>",
      "css": ".ds-rank-table{border-collapse:collapse;width:100%;font:400 12px/1.5 Switzer,Arial,sans-serif;font-variant-numeric:tabular-nums;color:var(--lw-ink,#182e28);background:var(--lw-paper,#fff)}.ds-rank-table th,.ds-rank-table td{padding:11px 13px;text-align:right;border-bottom:1px solid var(--lw-rule,#dce5df)}.ds-rank-table thead th{padding-block:9px;background:var(--lw-tint,#edf3ef);font-size:10px;color:var(--lw-muted,#596b64);font-weight:400}.ds-rank-table th:nth-child(2){text-align:left}.ds-rank-table tbody th{padding-left:0;font-weight:400}.ds-rank-table tbody tr{transition:background 160ms ease-out}.ds-rank-table tbody tr:hover{background:var(--lw-bg,#f6f8f7)}.ds-rank-table .ds-selected{background:var(--lw-tint,#edf3ef)}.ds-rank-table .ds-score{font-weight:500;color:var(--lw-accent,#1c684e)}.ds-rank-table button{border:0;padding:0;background:transparent;color:inherit;display:flex;align-items:center;justify-content:space-between;gap:9px;width:100%;min-height:28px;cursor:pointer;font:inherit}.ds-rank-table button:focus-visible{outline:2px solid var(--lw-accent,#1c684e);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-rank-table tbody tr{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "The Club Field Index",
    "overview": "A quiet field index pairs deep pine navigation with cool paper, pale sage selection and precise ruled records. Switzer carries headings, controls and tabular data in one voice. The application is compact enough to compare a full field while keeping source dates, model identity and uncertain evidence close to the values they qualify.\n\nThis system covers the shipped Rankings, Markets, Performance, Models, My card and Season archive workspace. Light and dark themes share structure and semantic roles. Embedded market and archive surfaces inherit the new palette and heading family while retaining their existing record geometry. Linked player, research, evaluation and system tools retain their earlier terminal system; the standalone shared-card reader retains the earlier desk shell.",
    "keyCharacteristics": [
      "Pine navigation with a pale, text-labeled active item.",
      "Self-hosted Switzer throughout the workspace, with tabular numerals.",
      "Flat paper panels, thin rules and modest control corners.",
      "Persistent selected-player identity with a shared field distribution and component bars.",
      "Charts and tables that keep units, cohort, model version and missing evidence visible."
    ],
    "rules": [
      {
        "name": "The Paired State Rule",
        "body": "Pair state color with text, a marker or a structural change: selected records retain their identity, warnings explain the limitation, and saved quotes show a check.",
        "section": "colors"
      },
      {
        "name": "The One Typeface Rule",
        "body": "Use Switzer for workspace headings, controls, prose and data. Keep numerical comparisons tabular and aligned.",
        "section": "typography"
      },
      {
        "name": "The Ruled Surface Rule",
        "body": "Separate records with tonal fills and thin rules. Keep data panels flat; the small pressed-segment shadow is a control state, not a card treatment.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the paired light and dark semantic palettes and the visible pale navigation selection.",
      "Do keep units, source age, model identity and evidence limitations next to the affected values.",
      "Do preserve stable player identity and a shared comparison scale when selection changes.",
      "Do retain horizontal comparison for the Rankings table and use labeled mobile records only for the tables that implement that pattern.",
      "Do keep color accompanied by text, marker shape or selection structure.",
      "Do retain semantic table headers when mobile presentation visually hides them."
    ],
    "donts": [
      "Don't present recorded model selections or paper returns as verified placed bets or profit.",
      "Don't erase missing data, uncertain provenance or research status with a success treatment.",
      "Don't extend the retained terminal or standalone shared-reader styling into the new workspace by default.",
      "Don't add decorative kickers, glyph icons, hard offset shadows or system-font display headings.",
      "Don't turn the observed 9–10px supporting annotations into a reusable primary-text standard."
    ]
  }
}
