# Live golf.shermandavison.com block from /etc/caddy/Caddyfile on 2026-11-16.
# Other sites in the server's Caddyfile are intentionally not included.
golf.shermandavison.com {
    encode zstd gzip
	@blocked not method GET HEAD OPTIONS
	respond @blocked 405

	@options method OPTIONS
	handle @options {
		header Access-Control-Allow-Origin https://shermandavison.com
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type"
		respond 204
	}

	header Access-Control-Allow-Origin https://shermandavison.com
	header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"

	handle /reports/* {
		root * /opt/golf-model/frontend/dist
		header Cache-Control "public, max-age=60"
		file_server
	}

	handle /api/market-evidence {
		reverse_proxy 127.0.0.1:8011
	}

	handle /api/desk/board {
		reverse_proxy 127.0.0.1:8011
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			transport http {
				dial_timeout 2s
			}
			@api_down status 502 503
			handle_response @api_down {
				header Content-Type application/json
				respond `{"ok":false,"db_unavailable":true,"data_state":"api_down","operator_message":"The API process is down. Last boards may still be cached in your browser."}` 503
			}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8000 {
			transport http {
				dial_timeout 2s
			}
			@down status 502 503
			handle_response @down {
				root * /opt/golf-model/frontend/dist
				rewrite * /index.html
				file_server
			}
		}
	}
}
