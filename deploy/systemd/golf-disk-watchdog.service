[Unit]
Description=Golf Model Disk Free-Space Watchdog
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/golf-model
Environment=GOLF_APP_ROOT=/opt/golf-model
Environment=GOLF_DATA_DIR=/opt/golf-model/data
EnvironmentFile=-/opt/golf-model/.env
ExecStart=/opt/golf-model/venv/bin/python /opt/golf-model/scripts/disk_watchdog.py --remediate --aggressive --json

[Install]
WantedBy=multi-user.target
