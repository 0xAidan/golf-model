[Unit]
Description=Golf Model Autoresearch Weekly Deep Cycle (ingestion + PIT + search)
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/golf-model
Environment=PATH=/opt/golf-model/venv/bin:/usr/bin:/bin
Environment=GOLF_APP_ROOT=/opt/golf-model
Environment=GOLF_DATA_DIR=/opt/golf-model/data
EnvironmentFile=-/opt/golf-model/.env
ExecStart=/opt/golf-model/venv/bin/python workers/autoresearch_orchestrator.py --weekly
TimeoutStartSec=5h

[Install]
WantedBy=multi-user.target
