[Unit]
Description=Golf Model weekly research refit and fixed-protocol audit
After=golf-autoresearch-deep.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/golf-learning/current
Environment=GOLF_APP_ROOT=/opt/golf-learning/current
Environment=GOLF_DATA_DIR=/opt/golf-model/data
Environment=GOLF_DB_PATH=/opt/golf-model/data/golf.db
Environment=PRESERVE_PREDICTION_HISTORY=1
Environment=TRACK_PROMOTION_ENABLED=0
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStartPre=/usr/bin/test -d /opt/golf-learning/runs
ExecStartPre=/opt/golf-model/venv/bin/python /opt/golf-learning/current/scripts/package_learning_release.py --verify-release /opt/golf-learning/current
ExecStart=/opt/golf-model/venv/bin/python /opt/golf-learning/current/scripts/weekly_learning_refresh.py --output /opt/golf-learning/runs --public-report /opt/golf-model/frontend/dist/reports/learning-latest.json
TimeoutStartSec=30min
Nice=10
CPUQuota=100%
MemoryMax=2G
TasksMax=32
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/opt/golf-model/data /opt/golf-learning/releases
ReadWritePaths=/opt/golf-learning/runs /opt/golf-model/frontend/dist/reports
