[Unit]
Description=Golf Model public-site uptime ping (ntfy on failure)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/golf-model
Environment=GOLF_APP_ROOT=/opt/golf-model
Environment=GOLF_DATA_DIR=/opt/golf-model/data
EnvironmentFile=-/opt/golf-model/.env
ExecStart=/opt/golf-model/venv/bin/python /opt/golf-model/scripts/external_uptime_watchdog.py --json
MemoryMax=128M

[Install]
WantedBy=multi-user.target
