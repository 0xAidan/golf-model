[Unit]
Description=Golf Model SQLite integrity smoke probe
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/golf-model
Environment=GOLF_APP_ROOT=/opt/golf-model
Environment=GOLF_DATA_DIR=/opt/golf-model/data
EnvironmentFile=-/opt/golf-model/.env
ExecStart=/opt/golf-model/venv/bin/python /opt/golf-model/scripts/db_integrity_watchdog.py --recover --json
MemoryMax=256M

[Install]
WantedBy=multi-user.target
